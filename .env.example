# ─── Shared saves (GitHub-backed persistence) ────────────────────────────────
# When set, every edit made in the app is committed to src/data/sectors.json
# in this repo, so all users see the same data. Without it, edits stay in each
# browser's localStorage only.
#
# Create a fine-grained personal access token at
# github.com → Settings → Developer settings → Fine-grained tokens:
#   Repository access: only this repo · Permissions: Contents → Read and write
GITHUB_TOKEN=

# Optional — override the repo/branch the data file is committed to
# GITHUB_DATA_REPO=skulkar8-debug/market-research-roadmap-stoc
# GITHUB_DATA_BRANCH=main

# ─── Google OAuth (Sheets API) ───────────────────────────────────────────────
# Required only for the Google Sheets sync features (Settings → Connect Google,
# Data + TIP sync). The app runs fine without these — it falls back to seed data.
#
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client (Web)
# 2. Authorized redirect URI: http://localhost:3000/api/auth/google/callback
#    (and your production URL, e.g. https://your-app.vercel.app/api/auth/google/callback)
# 3. Enable "Google Sheets API" for the project
# 4. The signed-in Google account must have Editor access to the spreadsheets below
# 5. If you see "insufficient authentication scopes", disconnect and reconnect Google
#    (old read-only tokens must be replaced with read+write permission)

# Client ID only — no http:// prefix, no trailing slash
# e.g. 123456789-abc.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret used to sign the OAuth session cookie (e.g. openssl rand -base64 32)
AUTH_SECRET=

# App URL for OAuth redirects (REQUIRED on Vercel — set to your production domain)
# Local:  http://localhost:3000
# Prod:   https://<your-project>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — override default spreadsheet ID and tab name
# GOOGLE_ROADMAP_SHEET_ID=1wqW8zgy2E_W6I5S_wi9iDqA4OWC0B74zd6l6_v3uQpo
# GOOGLE_ROADMAP_TAB=Sectors
